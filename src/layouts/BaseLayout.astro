---
import '@/styles/global.css';
import interLatin from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import SEO from '@/components/SEO.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import { LOCALE_TAGS, getDictionary, type Locale, type LocalizedPath } from '@/i18n';

interface Props {
  locale: Locale;
  title: string;
  description: string;
  /** Route without locale prefix, e.g. "" or "lab", or a per-locale record for translated slugs. */
  path?: LocalizedPath;
  alternates?: boolean;
  noindex?: boolean;
  ogType?: 'website' | 'article';
  jsonLd?: Record<string, unknown> | undefined;
}

const {
  locale,
  title,
  description,
  path = '',
  alternates = true,
  noindex = false,
  ogType = 'website',
  jsonLd,
} = Astro.props;
const t = getDictionary(locale);
---

<!doctype html>
<html lang={LOCALE_TAGS[locale].html} data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- The hero heading is the LCP element; preloading its font avoids a late swap that re-wraps it. -->
    <link rel="preload" href={interLatin} as="font" type="font/woff2" crossorigin />
    <!-- Applies the saved theme (light by default) before first paint to avoid a flash. -->
    <script is:inline>
      (function () {
        var root = document.documentElement;
        root.classList.add('js');
        var theme = null;
        try {
          theme = localStorage.getItem('theme');
        } catch (e) {}
        // Light by default; dark only when the visitor picked it with the toggle.
        if (theme !== 'dark') theme = 'light';
        root.setAttribute('data-theme', theme);
      })();
    </script>
    <meta name="theme-color" content="#FAFAF9" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="generator" content={Astro.generator} />
    <SEO
      title={title}
      description={description}
      locale={locale}
      path={path}
      alternates={alternates}
      noindex={noindex}
      ogType={ogType}
      jsonLd={jsonLd}
    />
  </head>
  <body class="min-h-dvh antialiased">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 focus:rounded-md focus:bg-accent focus:px-4 focus:py-2 focus:text-on-accent"
    >
      {t.a11y.skipToContent}
    </a>
    <Header locale={locale} path={path} />
    <main id="main" tabindex="-1" class="outline-none">
      <slot />
    </main>
    <Footer locale={locale} />
    <slot name="after-footer" />
    <script>
      import '@/scripts/main';
    </script>
  </body>
</html>
