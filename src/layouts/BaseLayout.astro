---
import '@/styles/global.css';
import SEO from '@/components/SEO.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import { LOCALE_TAGS, getDictionary, type Locale } from '@/i18n';

interface Props {
  locale: Locale;
  title: string;
  description: string;
  /** Route without locale prefix, e.g. "" or "lab". */
  path?: string;
  alternates?: boolean;
  noindex?: boolean;
}

const { locale, title, description, path = '', alternates = true, noindex = false } = Astro.props;
const t = getDictionary(locale);
---

<!doctype html>
<html lang={LOCALE_TAGS[locale].html} data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Applies the saved/system theme before first paint to avoid a flash. -->
    <script is:inline>
      (function () {
        var root = document.documentElement;
        root.classList.add('js');
        var theme = null;
        try {
          theme = localStorage.getItem('theme');
        } catch (e) {}
        if (theme !== 'light' && theme !== 'dark') {
          theme = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        }
        root.setAttribute('data-theme', theme);
      })();
    </script>
    <meta name="theme-color" content="#FAFAF9" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0C0C0C" media="(prefers-color-scheme: dark)" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="generator" content={Astro.generator} />
    <SEO
      title={title}
      description={description}
      locale={locale}
      path={path}
      alternates={alternates}
      noindex={noindex}
    />
  </head>
  <body class="min-h-dvh antialiased">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 focus:rounded-md focus:bg-accent focus:px-4 focus:py-2 focus:text-on-accent"
    >
      {t.a11y.skipToContent}
    </a>
    <Header locale={locale} path={path} />
    <main id="main" tabindex="-1" class="outline-none">
      <slot />
    </main>
    <Footer locale={locale} />
    <slot name="after-footer" />
    <script>
      import '@/scripts/main';
    </script>
  </body>
</html>
