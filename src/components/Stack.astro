---
import Section from '@/components/Section.astro';
import { STACK } from '@/data/stack';
import { getDictionary, type Locale } from '@/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getDictionary(locale);
---

<Section id="stack" eyebrow={t.stack.eyebrow} title={t.stack.title}>
  <div class="space-y-6">
    {
      STACK.map((group) => (
        <div class="sm:grid sm:grid-cols-[8rem_1fr] sm:gap-6">
          <h3 class="font-mono text-xs leading-7 text-muted">{t.stack.groups[group.key]}</h3>
          <ul class="mt-2 flex flex-wrap gap-2 sm:mt-0">
            {group.items.map((item) => (
              <li class="badge text-fg">
                {item.iconPath ? (
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" class="shrink-0 text-muted">
                    <path d={item.iconPath} />
                  </svg>
                ) : (
                  <span class="inline-block size-1.5 shrink-0 rounded-full bg-accent" aria-hidden="true" />
                )}
                {item.name}
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
</Section>
