---
import Section from '@/components/Section.astro';
import { getDictionary, type Locale } from '@/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getDictionary(locale);
---

<Section id="process" eyebrow={t.process.eyebrow} title={t.process.title}>
  <ol class="grid gap-4 sm:grid-cols-2">
    {
      t.process.steps.map((step, index) => (
        <li class="rounded-xl border border-border p-5">
          <span class="font-mono text-xs text-accent">{String(index + 1).padStart(2, '0')}</span>
          <h3 class="mt-2 font-semibold text-fg">{step.title}</h3>
          <p class="mt-1.5 text-sm leading-relaxed text-muted">{step.text}</p>
        </li>
      ))
    }
  </ol>
</Section>
