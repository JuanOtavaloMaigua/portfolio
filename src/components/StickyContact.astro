---
import { whatsappUrl } from '@/config/site';
import { siWhatsapp } from 'simple-icons';
import { getDictionary, type Locale } from '@/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getDictionary(locale);
---

<!-- Mobile-only contact bar; main.ts reveals it once the hero has scrolled out of view. -->
<div
  class="sticky-contact fixed inset-x-0 bottom-0 z-30 border-t border-border bg-bg/95 px-4 pt-3 pb-[max(0.75rem,env(safe-area-inset-bottom))] md:hidden"
  data-sticky-contact
  data-visible="false"
  inert
>
  <div class="mx-auto flex max-w-[720px]">
    <a href={whatsappUrl(t.contact.whatsappMessage)} class="btn btn-primary flex-1" target="_blank" rel="noopener">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" class="shrink-0">
        <path d={siWhatsapp.path} />
      </svg>
      {t.contact.sticky}
    </a>
  </div>
</div>

<style>
  .sticky-contact {
    transform: translateY(110%);
    transition: transform 250ms ease;
  }

  .sticky-contact[data-visible='true'] {
    transform: none;
  }
</style>
