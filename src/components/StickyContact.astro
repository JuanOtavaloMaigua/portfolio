---
import { SITE } from '@/config/site';
import { getDictionary, type Locale } from '@/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getDictionary(locale);
---

<!-- Mobile-only contact bar; main.ts reveals it once the hero has scrolled out of view. -->
<div
  class="sticky-contact fixed inset-x-0 bottom-0 z-30 border-t border-border bg-bg/95 px-4 pt-3 pb-[max(0.75rem,env(safe-area-inset-bottom))] md:hidden"
  data-sticky-contact
  data-visible="false"
  inert
>
  <div class="mx-auto flex max-w-[720px] gap-2">
    <a href={SITE.calUrl} class="btn btn-primary flex-1" target="_blank" rel="noopener">{t.contact.sticky}</a>
    <a href={SITE.whatsappUrl} class="btn btn-secondary" target="_blank" rel="noopener">{t.contact.whatsapp}</a>
  </div>
</div>

<style>
  .sticky-contact {
    transform: translateY(110%);
    transition: transform 250ms ease;
  }

  .sticky-contact[data-visible='true'] {
    transform: none;
  }
</style>
