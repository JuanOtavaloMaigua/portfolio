---
/**
 * Static, server-rendered poster of the hero node network. It is the no-JS / reduced-motion /
 * low-end fallback, and the frame the WebGL canvas crossfades from.
 * Dots are zero-length round-capped strokes with non-scaling width, so they keep a constant
 * pixel size like the WebGL points.
 */
import { NODE_COUNT_COARSE, NODE_COUNT_FINE, getNetwork, projectToPoster } from './network';

const round = (value: number) => Math.round(value * 10) / 10;

function paths(count: number) {
  const { nodes, edges } = getNetwork(count);
  const points = nodes.map((node) => projectToPoster(node));
  const at = (index: number) => points[index] ?? { x: 0, y: 0 };
  const dot = (index: number) => `M${round(at(index).x)} ${round(at(index).y)}h0`;
  return {
    edges: edges.map(([a, b]) => `M${round(at(a).x)} ${round(at(a).y)}L${round(at(b).x)} ${round(at(b).y)}`).join(''),
    nodes: nodes.flatMap((node, i) => (node.hub ? [] : [dot(i)])).join(''),
    hubs: nodes.flatMap((node, i) => (node.hub ? [dot(i)] : [])).join(''),
  };
}

const variants = [
  { className: 'net-coarse', ...paths(NODE_COUNT_COARSE) },
  { className: 'net-fine', ...paths(NODE_COUNT_FINE) },
];
---

<svg
  data-network-poster
  viewBox="-100 -100 200 200"
  preserveAspectRatio="xMidYMid meet"
  overflow="visible"
  focusable="false"
  aria-hidden="true"
>
  {
    variants.map((variant) => (
      <g class={variant.className}>
        <path class="net-edge" d={variant.edges} />
        <path class="net-node" d={variant.nodes} />
        <path class="net-hub" d={variant.hubs} />
      </g>
    ))
  }
</svg>
