---
import type { CollectionEntry } from 'astro:content';
import { getDictionary, type Locale } from '@/i18n';

interface Props {
  project: CollectionEntry<'projects'>;
  locale: Locale;
}

const { project, locale } = Astro.props;
const t = getDictionary(locale);
const { title, context, problem, solution, result, tech, status, client } = project.data;
const isProduction = status === 'production';

const steps = [
  { label: t.projects.problem, text: problem },
  { label: t.projects.solution, text: solution },
  { label: t.projects.result, text: result },
];
---

<article class="rounded-xl border border-border bg-surface/60 p-5 sm:p-6">
  <div class="flex flex-wrap items-start justify-between gap-x-4 gap-y-2">
    <h3 class="text-lg font-semibold tracking-tight text-fg">{title}</h3>
    <span
      class:list={[
        'badge shrink-0',
        isProduction ? 'border-success/40 text-fg' : 'text-muted',
      ]}
    >
      <span
        class:list={['inline-block size-1.5 rounded-full', isProduction ? 'bg-success' : 'bg-muted']}
        aria-hidden="true"></span>
      {t.projects.status[status]}
    </span>
  </div>

  <p class="mt-1.5 text-sm text-muted">
    {client && <span class="font-medium text-fg">{t.projects.client}: {client}. </span>}
    {context}
  </p>

  <dl class="mt-5 space-y-3 text-sm leading-relaxed">
    {
      steps.map((step) => (
        <div class="grid gap-1 sm:grid-cols-[6.5rem_1fr] sm:gap-4">
          <dt class="font-mono text-xs leading-6 text-accent">{step.label}</dt>
          <dd class="text-fg/90">{step.text}</dd>
        </div>
      ))
    }
  </dl>

  <ul class="mt-5 flex flex-wrap gap-1.5" aria-label={t.projects.tech}>
    {tech.map((name) => <li class="badge">{name}</li>)}
  </ul>
</article>
