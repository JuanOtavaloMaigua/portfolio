---
interface Props {
  id: string;
  eyebrow: string;
  title: string;
  intro?: string;
}

const { id, eyebrow, title, intro } = Astro.props;
const headingId = `${id}-title`;
---

<section id={id} aria-labelledby={headingId} class="container-page reveal py-16 sm:py-20">
  <p class="font-mono text-xs tracking-wide text-accent uppercase">{eyebrow}</p>
  <h2 id={headingId} class="mt-2 text-2xl font-semibold tracking-tight text-fg sm:text-3xl">{title}</h2>
  {intro && <p class="mt-3 text-muted">{intro}</p>}
  <div class="mt-10">
    <slot />
  </div>
</section>
