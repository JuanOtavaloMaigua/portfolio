---
import { getEntry, render } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import WeaveDivider from '@/components/WeaveDivider.astro';
import StoryVisual from '@/components/story/StoryVisual';
import StoryVisualPanel from '@/components/story/StoryVisualPanel';
import { SITE, whatsappUrl } from '@/config/site';
import { entrySlug, type StoryEntry } from '@/lib/content';
import {
  LOCALE_TAGS,
  formatMonthYear,
  getDictionary,
  localizePath,
  otherLocale,
  storyPaths,
  type Locale,
} from '@/i18n';

interface Props {
  locale: Locale;
  entry: StoryEntry;
}

const { locale, entry } = Astro.props;
const t = getDictionary(locale);
const { data } = entry;
const { story } = data;
const slug = entrySlug(entry);
const { Content } = await render(entry);

// hreflang/switcher only point to the counterpart when it really exists; otherwise to its home.
const other = otherLocale(locale);
const counterpart = await getEntry('experience', `${other}/${slug}`);
const hasCounterpart = counterpart?.data.story !== undefined;
const paths = storyPaths(slug);
const path = hasCounterpart ? paths : { ...paths, [other]: '' };

const home = localizePath(locale);
const period = `${formatMonthYear(data.start, locale)} – ${data.end ? formatMonthYear(data.end, locale) : t.experience.present}`;
const paragraphs = (text: string) => text.split(/\n\s*\n/).map((p) => p.trim()).filter(Boolean);
const site = Astro.site ?? new URL(SITE.url);
const url = new URL(localizePath(locale, paths), site).href;
const title = `${story.title} — ${t.story.titleSuffix}`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: story.title,
  description: story.summary,
  url,
  mainEntityOfPage: url,
  inLanguage: LOCALE_TAGS[locale].html,
  image: new URL(SITE.ogImage, site).href,
  author: { '@type': 'Person', name: SITE.name, url: new URL(home, site).href, jobTitle: SITE.jobTitle },
  about: { '@type': 'Organization', name: data.company },
  keywords: story.stack.join(', '),
  temporalCoverage: `${data.start.toISOString().slice(0, 7)}/${(data.end ?? new Date()).toISOString().slice(0, 7)}`,
};
---

<BaseLayout
  locale={locale}
  title={title}
  description={story.summary}
  path={path}
  alternates={hasCounterpart}
  ogType="article"
  jsonLd={jsonLd}
>
  <article aria-labelledby="story-title">
    <header class="container-page pt-10 pb-12 sm:pt-14 sm:pb-16">
      <a href={`${home}#experience`} class="link inline-flex min-h-11 items-center font-mono text-xs text-muted">
        ← {t.story.back}
      </a>
      <p class="mt-6 font-mono text-xs tracking-wide text-accent uppercase">
        {story.industry} · {period}
      </p>
      <h1 id="story-title" class="mt-3 text-3xl font-semibold tracking-tight text-balance text-fg sm:text-4xl">
        {story.title}
      </h1>
      <p class="mt-4 text-lg leading-relaxed text-muted">{story.summary}</p>
      <dl class="mt-8 space-y-3 font-mono text-xs">
        <div class="grid grid-cols-[5.5rem_minmax(0,1fr)] gap-3">
          <dt class="text-muted">{t.story.role}</dt>
          <dd class="text-fg">{data.role} · {data.company}</dd>
        </div>
        <div class="grid grid-cols-[5.5rem_minmax(0,1fr)] gap-3">
          <dt class="text-muted">{t.story.location}</dt>
          <dd class="text-fg">{data.location}</dd>
        </div>
        <div class="grid grid-cols-[5.5rem_minmax(0,1fr)] gap-3">
          <dt class="pt-1 text-muted">{t.story.stack}</dt>
          <dd>
            <ul class="flex flex-wrap gap-1.5">
              {story.stack.map((tech) => <li class="badge">{tech}</li>)}
            </ul>
          </dd>
        </div>
      </dl>
    </header>

    <WeaveDivider id="story-1" />

    <div
      class="mx-auto w-full max-w-[720px] px-4 py-8 sm:px-6 lg:grid lg:max-w-[1100px] lg:grid-cols-[minmax(0,1fr)_minmax(0,1.1fr)] lg:gap-16"
    >
      <ol class="list-none" aria-label={t.story.storyLabel}>
        {
          story.blocks.map((block) => (
            <li>
              <section
                id={block.id}
                data-story-block
                data-visual={block.visual}
                aria-labelledby={`${block.id}-title`}
                class="py-10 lg:flex lg:min-h-[75vh] lg:flex-col lg:justify-center"
              >
                <p class="font-mono text-xs tracking-wide text-accent uppercase">{block.eyebrow}</p>
                <h2 id={`${block.id}-title`} class="mt-2 text-2xl font-semibold tracking-tight text-balance text-fg">
                  {block.title}
                </h2>
                <div class="mt-5 rounded-xl border border-border bg-surface/50 p-3 lg:hidden">
                  <StoryVisual
                    client:visible={{ rootMargin: '200px' }}
                    visual={block.visual}
                    labels={t.story.visuals}
                    orientation="vertical"
                  />
                </div>
                <div class="mt-5 space-y-4 leading-relaxed text-fg/90">
                  {paragraphs(block.body).map((p) => (
                    <p>{p}</p>
                  ))}
                </div>
              </section>
            </li>
          ))
        }
      </ol>

      <div class="hidden lg:block">
        <div class="sticky top-24 flex h-[calc(100dvh-8rem)] items-center">
          <div class="w-full rounded-2xl border border-border bg-surface/50 p-6">
            <StoryVisualPanel
              client:visible
              visuals={story.blocks.map((block) => block.visual)}
              labels={t.story.visuals}
            />
          </div>
        </div>
      </div>
    </div>

    <WeaveDivider id="story-2" />

    <section id="technical" aria-labelledby="technical-title" class="container-page py-16 sm:py-20">
      <p class="font-mono text-xs tracking-wide text-accent uppercase">{t.story.technical.eyebrow}</p>
      <h2 id="technical-title" class="mt-2 text-2xl font-semibold tracking-tight text-fg sm:text-3xl">
        {t.story.technical.title}
      </h2>
      <div class="story-prose mt-8">
        <Content />
      </div>
    </section>

    <WeaveDivider id="story-3" />
  </article>

  <section aria-labelledby="story-cta-title" class="container-page py-16 sm:py-20">
    <h2 id="story-cta-title" class="text-2xl font-semibold tracking-tight text-balance text-fg sm:text-3xl">
      {t.story.cta.title}
    </h2>
    <p class="mt-3 text-muted">{t.story.cta.text}</p>
    <div class="mt-8 flex flex-col gap-3 sm:flex-row">
      <a href={whatsappUrl(t.contact.whatsappMessage)} class="btn btn-primary" target="_blank" rel="noopener">{t.story.cta.schedule}</a>
      <a href={`mailto:${SITE.email}`} class="btn btn-secondary">{t.story.cta.email}</a>
    </div>
    <a href={`${home}#experience`} class="link mt-10 inline-flex min-h-11 items-center font-mono text-sm">
      ← {t.story.cta.home}
    </a>
  </section>
</BaseLayout>

<style>
  .story-prose :global(h3) {
    margin-top: 2rem;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .story-prose :global(h3:first-child) {
    margin-top: 0;
  }

  .story-prose :global(p),
  .story-prose :global(ul) {
    margin-top: 0.75rem;
    line-height: 1.7;
    color: color-mix(in oklab, var(--color-fg) 90%, transparent);
  }

  .story-prose :global(ul) {
    padding-left: 1.125rem;
    list-style: disc;
  }

  .story-prose :global(li + li) {
    margin-top: 0.5rem;
  }

  .story-prose :global(li::marker) {
    color: var(--color-accent);
  }

  .story-prose :global(strong) {
    font-weight: 600;
    color: var(--color-fg);
  }
</style>
