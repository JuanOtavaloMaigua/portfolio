---
import { getDictionary, localizePath, type Locale } from '@/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getDictionary(locale);
const year = new Date().getFullYear();
---

<footer class="border-t border-border">
  <div class="container-page flex items-center justify-between gap-4 py-8 pb-24 font-mono text-xs text-muted md:pb-8">
    <p>© {year} {t.footer.rights}</p>
    <a href={localizePath(locale, 'lab')} class="link inline-flex min-h-11 items-center text-muted">{t.footer.lab}</a>
  </div>
</footer>
