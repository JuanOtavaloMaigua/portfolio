---
import Section from '@/components/Section.astro';
import { SITE } from '@/config/site';
import { getDictionary, type Locale } from '@/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getDictionary(locale);

const links = [
  { href: `mailto:${SITE.email}`, label: t.contact.email, detail: SITE.email, external: false },
  { href: SITE.whatsappUrl, label: t.contact.whatsapp, detail: 'wa.me', external: true },
  { href: SITE.linkedinUrl, label: t.contact.linkedin, detail: 'in/juan-otavalo', external: true },
  { href: SITE.githubUrl, label: t.contact.github, detail: 'JuanOtavaloMaigua', external: true },
];
---

<Section id="contact" eyebrow={t.contact.eyebrow} title={t.contact.title} intro={t.contact.text}>
  <a href={SITE.calUrl} class="btn btn-primary w-full sm:w-auto" target="_blank" rel="noopener">
    {t.contact.schedule}
  </a>

  <ul class="mt-6 grid gap-2 sm:grid-cols-2">
    {
      links.map((link) => (
        <li>
          <a
            href={link.href}
            class="flex min-h-14 items-center justify-between gap-3 rounded-lg border border-border px-4 py-3 transition-colors hover:border-fg"
            {...(link.external ? { target: '_blank', rel: 'noopener me' } : {})}
          >
            <span class="font-medium text-fg">{link.label}</span>
            <span class="min-w-0 truncate font-mono text-xs text-muted">{link.detail}</span>
          </a>
        </li>
      ))
    }
  </ul>
</Section>
