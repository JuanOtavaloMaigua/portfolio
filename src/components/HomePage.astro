---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/Hero.astro';
import Projects from '@/components/Projects.astro';
import Experience from '@/components/Experience.astro';
import Process from '@/components/Process.astro';
import Stack from '@/components/Stack.astro';
import Contact from '@/components/Contact.astro';
import StickyContact from '@/components/StickyContact.astro';
import WeaveDivider from '@/components/WeaveDivider.astro';
import { getDictionary, type Locale } from '@/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getDictionary(locale);
---

<BaseLayout locale={locale} title={t.meta.title} description={t.meta.description}>
  <Hero locale={locale} />
  <WeaveDivider id="1" />
  <Projects locale={locale} />
  <WeaveDivider id="2" />
  <Experience locale={locale} />
  <WeaveDivider id="3" />
  <Process locale={locale} />
  <WeaveDivider id="4" />
  <Stack locale={locale} />
  <WeaveDivider id="5" />
  <Contact locale={locale} />
  <StickyContact slot="after-footer" locale={locale} />
</BaseLayout>
