---
import IndustryNetwork from '@/components/hero/IndustryNetwork';
import { INDUSTRIES, INDUSTRY_STORIES, STACKS, TECHS, type IndustryId } from '@/data/network';
import { SITE } from '@/config/site';
import { getDictionary, localizePath, storyPaths, type Locale } from '@/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getDictionary(locale);
const network = t.hero.network;
const storyHrefs: Partial<Record<IndustryId, string>> = Object.fromEntries(
  Object.entries(INDUSTRY_STORIES).map(([industry, slug]) => [industry, localizePath(locale, storyPaths(slug))]),
);
---

<!--
  The network is the hero background: it sits in normal flow (so it sizes the hero with no layout shift)
  and the copy is stacked on top of it in the same grid cell. The copy lets taps through to the network,
  except on its links. network.ts keeps labels out of the area the copy covers.
-->
<section class="hero" aria-labelledby="hero-title" data-hero>
  <div class="hero-copy container-page">
    <h1 id="hero-title" class="hero-halo text-4xl leading-[1.1] font-semibold tracking-tight text-balance text-fg sm:text-5xl">
      {t.hero.title}
    </h1>

    <p class="hero-halo mt-5 font-mono text-xs leading-relaxed text-muted sm:text-sm">{t.hero.tagline}</p>

    <div class="mt-8 flex flex-col items-start gap-3 sm:flex-row">
      <a href={SITE.calUrl} class="btn btn-primary" target="_blank" rel="noopener">
        {t.hero.ctaPrimary}
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M5 12h14M13 6l6 6-6 6"></path>
        </svg>
      </a>
      <a href={`mailto:${SITE.email}`} class="btn btn-secondary bg-bg">{t.hero.ctaSecondary}</a>
    </div>
  </div>

  <div class="hero-net">
    <IndustryNetwork client:visible={{ rootMargin: '200px' }} labels={network} storyHrefs={storyHrefs} />
  </div>

  <div class="sr-only">
    <p>{network.listTitle}</p>
    <ul>
      {
        INDUSTRIES.map((industry) => (
          <li>
            {network.industries[industry]}: {STACKS[industry].map((tech) => TECHS[tech]).join(', ')}
          </li>
        ))
      }
    </ul>
  </div>
</section>
