---
import ProductNetwork from '@/components/hero/ProductNetwork';
import { whatsappUrl } from '@/config/site';
import { PRODUCT_IDS, PRODUCT_STORIES, type ProductId } from '@/data/network';
import { getDictionary, localizePath, storyPaths, type Locale } from '@/i18n';
import { splitMarks } from '@/lib/marks';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getDictionary(locale);
const network = t.hero.network;
const storyHrefs: Partial<Record<ProductId, string>> = Object.fromEntries(
  Object.entries(PRODUCT_STORIES).map(([product, slug]) => [product, localizePath(locale, storyPaths(slug))]),
);
---

<!--
  Copy first, then the product network below it, at every width. The network picks its compact or wide
  layout with CSS (see ProductNetwork.tsx), so it is server-rendered at its final size: no layout shift.
-->
<section class="hero" aria-labelledby="hero-title" data-hero>
  <div class="hero-copy container-page">
    <h1 id="hero-title" class="text-4xl leading-[1.1] font-semibold tracking-tight text-balance text-fg sm:text-5xl">
      {splitMarks(t.hero.title).map((part) => (part.mark ? <span class="text-accent">{part.text}</span> : part.text))}
    </h1>

    <p class="hero-role mt-5">{t.hero.tagline}</p>

    <div class="mt-7 flex">
      <a href={whatsappUrl(t.contact.whatsappMessage)} class="btn btn-primary" target="_blank" rel="noopener">
        {t.hero.cta}
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M5 12h14M13 6l6 6-6 6"></path>
        </svg>
      </a>
    </div>
  </div>

  <div class="hero-products">
    <ProductNetwork client:visible={{ rootMargin: '200px' }} labels={network} storyHrefs={storyHrefs} />
  </div>

  <div class="sr-only">
    <p>{network.productsTitle}</p>
    <ul>
      {
        PRODUCT_IDS.map((product) => (
          <li>
            {network.products[product].name}: {network.products[product].description}
          </li>
        ))
      }
    </ul>
  </div>
</section>
