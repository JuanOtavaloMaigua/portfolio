---
import ThemeToggle from '@/components/ThemeToggle.astro';
import LanguageSwitcher from '@/components/LanguageSwitcher.astro';
import { getDictionary, localizePath, type Locale, type LocalizedPath } from '@/i18n';
import { SITE } from '@/config/site';

interface Props {
  locale: Locale;
  path?: LocalizedPath;
}

const { locale, path = '' } = Astro.props;
const t = getDictionary(locale);
const home = localizePath(locale);

const links = [
  { href: `${home}#projects`, label: t.nav.projects },
  { href: `${home}#experience`, label: t.nav.experience },
  { href: `${home}#contact`, label: t.nav.contact },
];
---

<header class="sticky top-0 z-40 border-b border-border/70 bg-bg">
  <div class="container-page flex h-16 items-center justify-between gap-4">
    <a href={home} class="font-semibold tracking-tight text-fg" aria-label={t.a11y.home}>
      {SITE.name}
    </a>

    <div class="flex items-center gap-1 sm:gap-2">
      <nav aria-label={t.a11y.mainNav} class="hidden md:block">
        <ul class="flex items-center gap-1">
          {
            links.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="rounded-md px-3 py-2 text-sm text-muted transition-colors hover:text-fg"
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <LanguageSwitcher locale={locale} path={path} />
      <ThemeToggle label={t.a11y.toggleTheme} />

      <button
        type="button"
        class="inline-flex size-11 items-center justify-center rounded-md text-fg md:hidden"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label={t.a11y.openMenu}
        data-menu-button
        data-label-open={t.a11y.openMenu}
        data-label-close={t.a11y.closeMenu}
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" aria-hidden="true">
          <path d="M4 7h16M4 12h16M4 17h16"></path>
        </svg>
      </button>
    </div>
  </div>

  <div id="mobile-menu" class="border-t border-border/70 md:hidden" data-menu-panel hidden>
    <nav aria-label={t.a11y.mainNav} class="container-page py-2">
      <ul class="flex flex-col">
        {
          links.map((link) => (
            <li>
              <a href={link.href} class="block py-3 text-base text-fg">
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>
