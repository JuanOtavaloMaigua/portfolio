---
/**
 * Subtle geometric divider inspired by Andean weaving (stepped diamonds / zigzag).
 * Purely decorative, very low contrast.
 */
interface Props {
  id: string;
}

const { id } = Astro.props;
const patternId = `weave-${id}`;
---

<div class="container-page" aria-hidden="true">
  <svg class="block h-3 w-full text-fg opacity-[0.12]" role="presentation" focusable="false">
    <defs>
      <pattern id={patternId} width="24" height="12" patternUnits="userSpaceOnUse">
        <path d="M0 6 L6 0 L12 6 L18 0 L24 6 M0 12 L6 6 L12 12 L18 6 L24 12" fill="none" stroke="currentColor" stroke-width="1"></path>
        <rect x="11" y="5" width="2" height="2" fill="currentColor"></rect>
      </pattern>
    </defs>
    <rect width="100%" height="100%" fill={`url(#${patternId})`}></rect>
  </svg>
</div>
